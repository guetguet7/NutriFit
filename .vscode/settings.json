{
  "intelephense.environment.phpVersion": "8.4.0",
  "intelephense.files.exclude": [
    "**/node_modules/**",
    "**/var/**"
  ],
  "files.exclude": {
    "**/node_modules/**": true,
    "**/var/**": true
  },
  "search.exclude": {
    "**/node_modules/**": true,
    "**/var/**": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/var/**": true
  },
  "php.validate.executablePath": "/usr/bin/php",
  "php.validate.enable": false
}
