<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}NutriFit{% endblock %}</title>
        <meta name="description" content="{% block description %}Site de nutrition et d'activité physique{% endblock %}">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
        
    </head>
    <body id="top">        
        {% block body %}{% endblock %}
    </body>
</html>
