<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}NutriFit{% endblock %}</title>
        <meta name="description" content="{% block description %}Site de sport{% endblock %}">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <link rel="preload" href="{{ asset('fonts/manrope/Manrope-400.woff2') }}" as="font" type="font/woff2" crossorigin>
        <link rel="preload" href="{{ asset('fonts/manrope/Manrope-600.woff2') }}" as="font" type="font/woff2" crossorigin>
        <link rel="preload" href="{{ asset('fonts/manrope/Manrope-700.woff2') }}" as="font" type="font/woff2" crossorigin>

        <link rel="icon" href="data:image/svg+xml;base64,">

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
        
    </head>
    <body id="top">        
        {% block body %}{% endblock %}
    </body>
</html>
