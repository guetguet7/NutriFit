{% extends 'layout.html.twig' %}
{% block title %}Ajouter une activité - NutriFit{% endblock %}

{% block content %}
	<div class="page-section">
		<section class="page-panel">
			<header class="panel-header--split">
				<div>
					<h1 class="panel-title">Ajouter une activité</h1>
					<p class="panel-subtitle">Enregistrez votre séance et les calories brûlées.</p>
				</div>
				<a class="btn btn--ghost" href="{{ path('activite') }}">Retour</a>
			</header>

				<form method="post" class="form-section" novalidate data-turbo="false">
					{% if formErrors is defined and formErrors|length > 0 and (fieldErrors is not defined or fieldErrors.global is not defined) %}
						<p class="form-helper form-helper--error">Veuillez corriger les champs en rouge.</p>
					{% endif %}
					{% if fieldErrors is defined and fieldErrors.global is defined %}
						<p class="form-helper form-helper--error">{{ fieldErrors.global|first }}</p>
					{% endif %}
				<section class="form-card">
					<h2 class="form-title">Infos principales</h2>
					<div class="grid grid--form">
						<div class="form-field">
							<label for="activity-type" class="form-label">Type d'activité</label>
							<select id="activity-type" name="type" class="form-select">
								<option value="course" {% if typeValue == 'course' %}selected{% endif %}>Course</option>
								<option value="marche" {% if typeValue == 'marche' %}selected{% endif %}>Marche</option>
								<option value="velo" {% if typeValue == 'velo' %}selected{% endif %}>Vélo</option>
								<option value="natation" {% if typeValue == 'natation' %}selected{% endif %}>Natation</option>
							</select>
							{% if fieldErrors is defined and fieldErrors.type is defined %}
								<p class="form-helper form-helper--error">{{ fieldErrors.type|first }}</p>
							{% endif %}
						</div>
						<div class="form-field">
							<label for="activity-date" class="form-label">Date / heure</label>
							<input id="activity-date" name="dateActivite" type="datetime-local" class="form-input" value="{{ dateActiviteValue }}" required>
							{% if fieldErrors is defined and fieldErrors.dateActivite is defined %}
								<p class="form-helper form-helper--error">{{ fieldErrors.dateActivite|first }}</p>
							{% endif %}
						</div>
							<div class="form-field">
								<label for="activity-duration" class="form-label">Durée (minutes)</label>
								{% if fieldErrors is defined and fieldErrors.dureeMin is defined %}
									<p class="form-helper form-helper--error">{{ fieldErrors.dureeMin|first }}</p>
								{% endif %}
								<input id="activity-duration" name="dureeMin" type="number" min="1" step="1" class="form-input" value="{{ dureeMinValue }}" required>
							</div>
					</div>
				</section>

				<section class="grid grid--form-wide">
					<article class="form-card">
						<h2 class="form-title">Calories brûlées</h2>
						<div class="panel-actions">
							<label class="inline-choice">
								<input type="radio" name="caloriesMode" value="auto" {% if caloriesModeValue != 'manual' %}checked{% endif %}>
								<span>Calculer automatiquement</span>
							</label>
							<label class="inline-choice">
								<input type="radio" name="caloriesMode" value="manual" {% if caloriesModeValue == 'manual' %}checked{% endif %}>
								<span>Je connais mes calories</span>
							</label>
						</div>
						{% if fieldErrors is defined and fieldErrors.caloriesMode is defined %}
							<p class="form-helper form-helper--error">{{ fieldErrors.caloriesMode|first }}</p>
						{% endif %}

						<div class="grid grid--form-small">
							<div class="form-field">
								<label for="activity-intensity" class="form-label">Intensité</label>
								<select id="activity-intensity" name="intensite" class="form-select">
									<option value="faible" {% if intensiteValue == 'faible' %}selected{% endif %}>Faible</option>
									<option value="moyenne" {% if intensiteValue == 'moyenne' %}selected{% endif %}>Moyenne</option>
									<option value="forte" {% if intensiteValue == 'forte' %}selected{% endif %}>Forte</option>
								</select>
								{% if fieldErrors is defined and fieldErrors.intensite is defined %}
									<p class="form-helper form-helper--error">{{ fieldErrors.intensite|first }}</p>
								{% endif %}
							</div>
							<div class="form-field">
								<label for="activity-level" class="form-label">Niveau</label>
								<select id="activity-level" name="niveau" class="form-select">
									<option value="debutant" {% if niveauValue == 'debutant' %}selected{% endif %}>Débutant</option>
									<option value="intermediaire" {% if niveauValue == 'intermediaire' %}selected{% endif %}>Intermédiaire</option>
									<option value="avance" {% if niveauValue == 'avance' %}selected{% endif %}>Avancé</option>
								</select>
							</div>
							<div class="form-field">
								<label for="activity-calories" class="form-label">Calories brûlées</label>
								<input id="activity-calories" name="caloriesBrulees" type="number" min="1" step="1" placeholder="Saisie manuelle" class="form-input" value="{{ caloriesBruleesValue }}">
								{% if fieldErrors is defined and fieldErrors.caloriesBrulees is defined %}
									<p class="form-helper form-helper--error">{{ fieldErrors.caloriesBrulees|first }}</p>
								{% endif %}
							</div>
						</div>

						<p class="form-helper form-helper--spaced">
							Estimation :
							{{ estimatedCalories is not null ? estimatedCalories ~ ' kcal' : '—' }}
							(selon votre profil et intensité)
						</p>
					</article>

					<article class="form-card">
						<h2 class="form-title">Détails optionnels</h2>
						<div class="stack">
							<div class="form-field">
								<label for="activity-distance" class="form-label">Distance (km)</label>
								<input id="activity-distance" name="distanceKm" type="number" min="0" step="0.1" class="form-input" value="{{ distanceKmValue }}">
							</div>
							<div class="form-field">
								<label for="activity-steps" class="form-label">Pas</label>
								<input id="activity-steps" name="pas" type="number" min="0" step="1" class="form-input" value="{{ pasValue }}">
							</div>
						</div>
					</article>
				</section>

				<section class="form-summary">
					<div>
						<p class="form-summary__label">Impact journée</p>
						<h2 class="form-summary__value">{{ estimatedCalories is not null ? estimatedCalories : 0 }}
							kcal</h2>
					</div>
					<div class="form-actions">
						<input type="hidden" name="_token" value="{{ csrf_token('create_activite') }}">
						<button class="btn btn--primary" type="submit">Enregistrer</button>
						<a class="btn btn--ghost" href="{{ path('activite') }}">Annuler</a>
					</div>
				</section>
			</form>
		</section>
	</div>
{% endblock %}
