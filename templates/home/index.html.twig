{% extends 'layout.html.twig' %}

{% block title %}Accueil - NutriFit{% endblock %}

{% block content %}
	<div class="home">
		<header class="hero hero--center hero--home">
			<picture class="hero__media" aria-hidden="true">
				<img src="{{ asset('img/Nutrifit.webp') }}" alt="Illustration NutriFit" loading="eager" decoding="async" fetchpriority="high">
			</picture>
			<span class="hero__overlay" aria-hidden="true"></span>
			<div class="hero__inner">
				<h1>Suivez votre forme physique,<br>atteignez vos objectifs</h1>
				<p class="lead">
					Votre partenaire personnel pour la forme et la nutrition. Enregistrez
					votre activité, suivez vos calories et obtenez des suggestions
					nutritionnelles pour atteindre vos objectifs.
				</p>
				<div class="hero__actions">
					<a class="btn btn--primary" href="{{ path('app_register') }}">Commencer gratuitement</a>
					<a class="btn btn--ghost" href="#features">En savoir plus</a>
				</div>
			</div>
		</header>

		<section class="features" id="features" aria-labelledby="features-title">
			<div class="section-head">
				<h2 id="features-title">Tout ce dont vous avez besoin pour réussir</h2>
			</div>
			<div class="features__grid">
				<article class="feature-card">
					<div class="feature-card__icon feature-card__icon--mint" aria-hidden="true">
						<svg viewbox="0 0 24 24" role="presentation">
							<path d="M4 12h4l2-6 4 12 2-6h4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
						</svg>
					</div>
					<h3>Suivi d'activité</h3>
					<p>Enregistrez vos entraînements : course, vélo, natation et plus encore.</p>
				</article>
				<article class="feature-card">
					<div class="feature-card__icon feature-card__icon--amber" aria-hidden="true">
						<svg viewbox="0 0 24 24" role="presentation">
							<circle cx="12" cy="12" r="6" fill="none" stroke="currentColor" stroke-width="2"></circle>
							<circle cx="12" cy="12" r="2" fill="currentColor"></circle>
						</svg>
					</div>
					<h3>Calculateur intelligent</h3>
					<p>Estimez vos besoins en calories et adaptez votre plan au quotidien.</p>
				</article>
				<article class="feature-card">
					<div class="feature-card__icon feature-card__icon--mint" aria-hidden="true">
						<svg viewbox="0 0 24 24" role="presentation">
							<path d="M12 3l1.8 3.6L18 8l-3 2.9.7 4.1-3.7-2-3.7 2 .7-4.1L6 8l4.2-1.4L12 3z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
						</svg>
					</div>
					<h3>Suggestions nutritionnelles</h3>
					<p>Recevez des recommandations personnalisées pour vos objectifs.</p>
				</article>
			</div>
		</section>

		<section class="cta-panel" aria-labelledby="cta-title">
			<div class="cta-panel__inner">
				<div class="cta-panel__icon" aria-hidden="true">
					<svg viewbox="0 0 24 24" role="presentation">
						<path d="M4 14l4-4 4 3 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
						<path d="M16 6h4v4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</div>
				<h2 id="cta-title">Lancez votre parcours forme dès maintenant</h2>
				<p>Rejoignez une communauté motivée qui progresse chaque semaine.</p>
				<a class="btn btn--light" href="{{ path('app_register') }}">S'inscrire</a>
			</div>
		</section>
	</div>
{% endblock %}
